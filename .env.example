# Base URL of the backend API (server-side fetches + image URLs).
BACKEND_URL=http://localhost:3001

# NextAuth — required. NEXTAUTH_URL is the canonical URL of this app;
# NEXTAUTH_SECRET signs/encrypts the session token (also used server-side to
# read the backend JWT off the session — see lib/server-auth.ts).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Google OAuth client. GOOGLE_CLIENT_ID must match the backend's GOOGLE_CLIENT_ID
# (the id_token is verified there against this same client).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# MercadoPago public key (browser checkout brick).
NEXT_PUBLIC_MP_PUBLIC_KEY=your-mercadopago-public-key

# WhatsApp contact CTA (optional; falls back to built-in defaults if unset).
NEXT_PUBLIC_WHATSAPP_PHONE=5491173666370 # Gonza
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola! Tengo una consulta sobre un producto.
